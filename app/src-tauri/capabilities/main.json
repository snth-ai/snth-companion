{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window may do: listen to the app's event channel and call the app's own commands. No shell, no file system, no remote content.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-get-journal",
    "allow-ui-ready",
    "allow-pair-begin",
    "allow-pair-confirm",
    "allow-pair-cancel",
    "allow-unpair",
    "allow-finish-onboarding",
    "allow-apply-preset",
    "allow-update-settings",
    "allow-suggested-roots",
    "allow-add-suggested-root",
    "allow-pick-folder",
    "allow-remove-root",
    "allow-set-root-write",
    "allow-revoke-grant",
    "allow-pause",
    "allow-resume",
    "allow-cua-check",
    "allow-cua-grant-permissions",
    "allow-cua-install",
    "allow-apps-check",
    "allow-apps-request-permission",
    "allow-set-language",
    "allow-set-autostart",
    "allow-set-stop-shortcut",
    "allow-check-update",
    "allow-install-update",
    "allow-set-auto-update",
    "allow-diagnostics",
    "allow-open-external"
  ]
}
