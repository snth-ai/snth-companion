{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window may do: listen to the app's event channel and call the app's own commands. No shell, no file system, no remote content.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-get-journal",
    "allow-ui-ready",
    "allow-pair-begin",
    "allow-pair-confirm",
    "allow-pair-cancel",
    "allow-unpair",
    "allow-unpair-synth",
    "allow-reconnect-synth",
    "allow-login-cancel",
    "allow-account-connect",
    "allow-account-sync",
    "allow-sign-out",
    "allow-finish-onboarding",
    "allow-apply-preset",
    "allow-update-settings",
    "allow-suggested-roots",
    "allow-add-suggested-root",
    "allow-pick-folder",
    "allow-remove-root",
    "allow-set-root-write",
    "allow-revoke-grant",
    "allow-pause",
    "allow-resume",
    "allow-cua-check",
    "allow-cua-grant-permissions",
    "allow-cua-install",
    "allow-computer-apps",
    "allow-cua-health-check",
    "allow-apps-check",
    "allow-apps-request-permission",
    "allow-logins-refresh",
    "allow-safari-check",
    "allow-vault-forget",
    "allow-browser-link",
    "allow-browser-unlink",
    "allow-browser-forget",
    "allow-set-language",
    "allow-set-autostart",
    "allow-set-stop-shortcut",
    "allow-check-update",
    "allow-install-update",
    "allow-set-auto-update",
    "allow-set-developer",
    "allow-diagnostics",
    "allow-open-external",
    "allow-island-set",
    "allow-island-hotkey-set",
    "allow-island-hotkey-reset",
    "allow-face-refresh",
    "allow-face-set",
    "allow-island-ask-design",
    "allow-island-mic",
    "allow-island-stt-set",
    "allow-island-stt-download",
    "allow-island-stt-cancel",
    "allow-island-stt-delete",
    "allow-island-wake-set",
    "allow-island-wake-phrase",
    "allow-island-wake-download",
    "allow-island-wake-download-cancel",
    "allow-island-wake-delete"
  ]
}
