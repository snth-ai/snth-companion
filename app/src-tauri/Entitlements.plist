<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is signed with the hardened runtime. Under it, sending
	     commands to another app (Calendar, Contacts, Reminders, Notes,
	     Messages: the Apps page) is refused outright unless this is set.
	     With it, macOS asks the owner once per app ("SNTH Connect wants
	     to control Calendar"). Nothing else is requested here. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
